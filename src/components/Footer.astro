---
import { site } from '../data/site.ts';
const ano = new Date().getFullYear();
---
<footer class="rodape">
  <div class="container rodape__linha">
    <p class="rodape__marca">{site.nome}</p>
    <p class="rodape__contato">
      <span class="razao rodape__rotulo">Contato</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
      {site.instagram && <a href={site.instagram}>Instagram</a>}
    </p>
    <p class="razao rodape__ano">© {ano}</p>
  </div>
</footer>

<style>
  /* fecho enxuto: uma linha só. O crédito do edital saiu daqui porque a faixa
     institucional logo acima já carrega os logos oficiais. */
  .rodape {
    background: var(--oliva-fundo);
    border-top: 1px solid var(--urdume);
    padding-block: 1.6rem;
    color: var(--osso-2);
    font-size: 0.9rem;
  }

  .rodape__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.7rem 2.5rem;
  }
  .rodape__linha p { margin: 0; max-width: none; }

  .rodape__marca {
    font-weight: 500;
    letter-spacing: 0.03em;
    color: var(--osso);
  }

  .rodape__contato {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.35rem 1.1rem;
  }
  .rodape__rotulo { color: var(--osso-2); }
  .rodape__contato a {
    color: var(--latao);
    text-decoration: none;
    border-bottom: 1px solid var(--urdume);
  }
  .rodape__contato a:hover {
    color: var(--latao-claro);
    border-bottom-color: var(--latao-claro);
  }

  .rodape__ano { color: var(--osso-2); }
</style>
