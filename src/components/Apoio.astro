---
// Faixa institucional OBRIGATÓRIA POR LEI (PNAB / Lei Aldir Blanc): os logos de
// financiamento e realização precisam permanecer visíveis sobre fundo branco de
// ponta a ponta. A superfície clara em meio ao índigo é intencional e não deve ser
// escurecida nem "harmonizada" com o sistema. Ver DESIGN.md.
// A arte oficial é um arquivo único de 1024x102. Para o mobile ela foi cortada
// em duas partes num corredor de espaço em branco (x=653), o que empilha as
// peças sem reagrupar marcas nem separar um rótulo do seu grupo: PRODUÇÃO e
// FINANCIAMENTO ficam inteiros na parte A, REALIZAÇÃO inteiro na parte B.
// No desktop as duas voltam a formar uma linha só. Não recortar mais fino nem
// deformar as marcas.
---
<section class="apoio" aria-labelledby="apoio-rotulo">
  <div class="container">
    <p class="razao apoio__rotulo" id="apoio-rotulo">Financiamento e realização</p>
    <div class="apoio__faixa">
      <img
        class="apoio__peca apoio__peca--a"
        src="/imagens/apoio/faixa-a.webp"
        width="653" height="102" loading="lazy"
        alt="Política Nacional Aldir Blanc (PNAB). Produção e financiamento: Pró-Cultura RS, Secretaria da Cultura e Governo do Estado do Rio Grande do Sul."
      />
      <img
        class="apoio__peca apoio__peca--b"
        src="/imagens/apoio/faixa-b.webp"
        width="371" height="102" loading="lazy"
        alt="Realização: Ministério da Cultura e Governo Federal do Brasil, União e Reconstrução."
      />
    </div>
  </div>
</section>

<style>
  .apoio {
    /* branco literal por exigência legal: as marcas oficiais não vão para fundo escuro */
    background: #ffffff;
    color: var(--tinta);
    border-block: 1px solid color-mix(in srgb, var(--tinta) 28%, transparent);
    padding-block: 1.7rem;
  }

  /* rótulo de campo em mono, medido contra o branco real desta faixa */
  .apoio__rotulo {
    margin: 0 0 1rem;
    color: var(--tinta);
  }

  /* anel de foco nunca em ouro sobre branco */
  .apoio :focus-visible { outline-color: var(--tinta); }

  /* mobile: as duas peças empilham e cada uma usa a largura inteira, o que
     dobra a altura útil dos logos sem rolagem lateral */
  .apoio__faixa {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.3rem;
  }
  .apoio__peca { width: 100%; height: auto; object-fit: contain; }

  /* desktop: as duas voltam a ser uma linha só, na proporção original */
  @media (min-width: 760px) {
    .apoio__faixa {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0;
      max-width: 1024px;
      margin-inline: auto;
    }
    .apoio__peca--a { width: 63.8%; }
    .apoio__peca--b { width: 36.2%; }
  }
</style>
