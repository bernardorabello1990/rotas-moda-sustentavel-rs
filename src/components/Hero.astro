---
import { site } from '../data/site.ts';
import Apoio from './Apoio.astro';
---
<section id="hero" class="heroi">
  <!-- brocado full-bleed: a trama cresce da esquerda escura para a direita dourada -->
  <picture class="heroi__brocado">
    <img
      src="/imagens/textura/tear-jacquard.webp"
      width="1376" height="768" fetchpriority="high" decoding="async"
      alt="Tecelagem: um pano de urdume índigo com listras douradas saindo de um tear jacquard, com um cartão perfurado apoiado sobre ele e o interior da fábrica ao fundo."
    />
  </picture>

  <div class="container heroi__conteudo">
    <!-- placa de tinta: superfície sólida pousada sobre a trama, o texto nunca disputa com o padrão -->
    <div class="heroi__placa">
      <p class="razao heroi__olho">Pesquisa cultural · Rio Grande do Sul</p>
      <h1 class="heroi__titulo">Moda<br />como<br />origem</h1>
      <p class="heroi__apoio">{site.descricao}</p>
      <div class="heroi__acoes">
        <a class="acao" href="#contato">Apoiar o projeto</a>
        <a class="acao acao--linho" href="#o-projeto">Ver a pesquisa</a>
      </div>
      <!-- convite para a experiência imersiva: ainda sem versão 9:16, só no desktop -->
      <a class="razao heroi__voo" href="/voo/" title="Experiência imersiva, melhor em tela grande">
        Sobrevoe as rotas <span>experiência imersiva</span>
      </a>
    </div>
  </div>

  <!-- a faixa institucional fecha o hero: os apoiadores oficiais na primeira vista -->
  <Apoio />
</section>

<style>
  /* o hero ocupa a tela inteira e a faixa institucional encosta no pé dela,
     de modo que nenhuma nesga da seção seguinte apareça na primeira vista */
  .heroi {
    position: relative;
    isolation: isolate;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
  }

  /* o brocado ocupa o viewport de borda a borda, atrás do texto */
  /* z-index -2: o véu (::before, em -1) tem de pintar POR CIMA da imagem.
     Com os dois em -1 o pseudo-elemento pinta antes e a foto engole o véu. */
  .heroi__brocado { position: absolute; inset: 0; z-index: -2; display: block; }
  /* a imagem é maior que o quadro e ancorada à esquerda: aproxima a trama e
     deixa só o denim escuro sob a coluna de texto. Continua sangrando nas bordas. */
  .heroi__brocado { overflow: hidden; }
  .heroi__brocado img { width: 100%; height: 100%; object-fit: cover; object-position: left center; }
  /* no mobile o recorte vai para a direita, onde estão o tear e o cartão perfurado */
  @media (max-width: 899px) {
    .heroi__brocado img { object-position: 78% center; }
  }
  .heroi::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    /* véu direcional: firme onde o texto vive, aberto onde a trama floresce */
    background: linear-gradient(
      98deg,
      rgba(14, 22, 38, 0.92) 0%,
      rgba(14, 22, 38, 0.86) 30%,
      rgba(14, 22, 38, 0.6) 48%,
      rgba(14, 22, 38, 0.22) 70%,
      rgba(14, 22, 38, 0.1) 100%
    );
  }
  /* no mobile o texto ocupa a largura toda e a foto está no recorte claro:
     o véu deixa de ser lateral e passa a ser vertical */
  @media (max-width: 899px) {
    .heroi::before {
      background: linear-gradient(
        to bottom,
        rgba(14, 22, 38, 0.9) 0%,
        rgba(14, 22, 38, 0.84) 55%,
        rgba(14, 22, 38, 0.62) 100%
      );
    }
  }

  .heroi__conteudo {
    flex: 1;
    /* como item flex, o margin-inline:auto do .container venceria o esticamento
       e jogaria a coluna de texto para o meio da tela */
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 5rem 1rem;
  }
  @media (min-width: 900px) {
    .heroi__conteudo { padding-block: 6.5rem 1.5rem; }
  }

  /* a placa: tinta sólida, filete de ouro, ar generoso. Nunca uma caixinha. */
  /* sem caixa: o texto fica direto na seda, numa coluna estreita à esquerda.
     A leitura vem da sombra no próprio glifo, que adensa a borda das letras
     sem desenhar nenhum retângulo. */
  .heroi__placa {
    width: 100%;
    max-width: 31rem;
    text-shadow: 0 1px 2px rgba(14, 22, 38, 0.9), 0 2px 14px rgba(14, 22, 38, 0.72);
  }

  .heroi__olho { margin: 0 0 1.6rem; color: var(--ouro); }

  .heroi__titulo {
    font-size: clamp(3.6rem, 11vw, 6rem);
    line-height: 0.92;
    letter-spacing: 0.045em;
    margin-bottom: 1.8rem;
    max-width: 12ch;
  }
  .heroi__apoio {
    color: var(--linho);
    font-size: 1.06rem;
    max-width: 33rem;
    margin-bottom: 2.4rem;
  }
  .heroi__acoes { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* o convite ao /voo é um fio, não um terceiro botão: não disputa com a ação principal */
  .heroi__voo {
    display: inline-block;
    margin-top: 1.9rem;
    color: var(--ouro);
    text-decoration: none;
    border-bottom: 1px solid rgba(201, 162, 39, 0.45);
    padding-bottom: 3px;
    transition: color 0.25s ease, border-color 0.25s ease;
  }
  .heroi__voo span { color: var(--linho-2); }
  .heroi__voo:hover { color: var(--ouro-claro); border-bottom-color: var(--ouro-claro); }
  .heroi__voo:hover span { color: var(--linho); }
  /* a experiência ainda não tem versão 9:16: não convidar quem não pode entrar */
  @media (max-width: 859px), (hover: none) and (pointer: coarse) {
    .heroi__voo { display: none; }
  }

</style>
