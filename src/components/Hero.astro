---
import regioes from '../data/regioes.json';
import { site } from '../data/site.ts';

const fio: Record<string, string> = {
  serra: 'var(--fio-serra)',
  sinos: 'var(--fio-sinos)',
  campanha: 'var(--fio-campanha)',
  metropolitana: 'var(--fio-poa)',
};
const curto: Record<string, string> = {
  serra: 'Serra Gaúcha',
  sinos: 'Vale dos Sinos',
  campanha: 'Campanha',
  metropolitana: 'Porto Alegre',
};
const ordem = ['serra', 'sinos', 'campanha', 'metropolitana'];
---
<section id="hero" class="heroi">
  <!-- brocado full-bleed: a trama cresce da esquerda escura para a direita dourada -->
  <picture class="heroi__brocado">
    <source media="(min-width: 760px)" srcset="/imagens/textura/brocado-hero.webp" />
    <img
      src="/imagens/textura/brocado-hero-mobile.webp"
      width="1920" height="1072" fetchpriority="high" decoding="async"
      alt="Brocado jacquard: seda índigo com trama de fios dourados formando um motivo têxtil ornamentado."
    />
  </picture>

  <div class="container heroi__conteudo">
    <!-- placa de tinta: superfície sólida pousada sobre a trama, o texto nunca disputa com o padrão -->
    <div class="heroi__placa">
      <p class="razao heroi__olho">Pesquisa cultural · Rio Grande do Sul</p>
      <h1 class="heroi__titulo">Moda<br />como<br />origem</h1>
      <p class="heroi__apoio">{site.descricao}</p>
      <div class="heroi__acoes">
        <a class="acao" href="#contato">Apoiar o projeto</a>
        <a class="acao acao--linho" href="#o-projeto">Ver a pesquisa</a>
      </div>
    </div>
  </div>

  <!-- faixa de cartão perfurado: os quatro territórios como instrução numerada -->
  <div class="cartao rota">
    <div class="container rota__grade">
      <p class="razao rota__legenda">A rota <span>4 territórios</span></p>
      <ol class="rota__lista">
        {ordem.map((id, i) => {
          const r = regioes.find((x) => x.id === id);
          return (
            <li class="rota__item">
              <span class="razao rota__num">{String(i + 1).padStart(2, '0')}</span>
              <span class="rota__nome" style={`--fio:${fio[id]}`}>{curto[id]}</span>
              <span class="rota__vocacao">{r?.vocacao}</span>
            </li>
          );
        })}
      </ol>
    </div>
  </div>
</section>

<style>
  .heroi { position: relative; isolation: isolate; }

  /* o brocado ocupa o viewport de borda a borda, atrás do texto */
  /* z-index -2: o véu (::before, em -1) tem de pintar POR CIMA da imagem.
     Com os dois em -1 o pseudo-elemento pinta antes e a foto engole o véu. */
  .heroi__brocado { position: absolute; inset: 0; z-index: -2; display: block; }
  /* a imagem é maior que o quadro e ancorada à esquerda: aproxima a trama e
     deixa só o denim escuro sob a coluna de texto. Continua sangrando nas bordas. */
  .heroi__brocado { overflow: hidden; }
  .heroi__brocado img { width: 100%; height: 100%; object-fit: cover; object-position: left center; }
  @media (min-width: 900px) {
    /* zoom: aproxima a trama e joga o ouro para a direita, abrindo área de
       índigo à esquerda, onde o texto pousa */
    .heroi__brocado img { width: 162%; }
  }
  .heroi::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    /* véu direcional: firme onde o texto vive, aberto onde a trama floresce */
    background: linear-gradient(
      98deg,
      rgba(14, 22, 38, 0.92) 0%,
      rgba(14, 22, 38, 0.86) 30%,
      rgba(14, 22, 38, 0.6) 48%,
      rgba(14, 22, 38, 0.22) 70%,
      rgba(14, 22, 38, 0.1) 100%
    );
  }

  .heroi__conteudo {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    padding-block: 5rem 5.5rem;
    min-height: min(78vh, 660px);
  }
  @media (min-width: 900px) {
    .heroi__conteudo { padding-block: 7.5rem 7.5rem; min-height: min(82vh, 720px); }
  }

  /* a placa: tinta sólida, filete de ouro, ar generoso. Nunca uma caixinha. */
  /* sem caixa: o texto fica direto na seda, numa coluna estreita à esquerda.
     A leitura vem da sombra no próprio glifo, que adensa a borda das letras
     sem desenhar nenhum retângulo. */
  .heroi__placa {
    width: 100%;
    max-width: 31rem;
    text-shadow: 0 1px 2px rgba(14, 22, 38, 0.9), 0 2px 14px rgba(14, 22, 38, 0.72);
  }

  .heroi__olho { margin: 0 0 1.6rem; color: var(--ouro); }

  .heroi__titulo {
    font-size: clamp(3.6rem, 11vw, 6rem);
    line-height: 0.92;
    letter-spacing: 0.045em;
    margin-bottom: 1.8rem;
    max-width: 12ch;
  }
  .heroi__apoio {
    color: var(--linho);
    font-size: 1.06rem;
    max-width: 33rem;
    margin-bottom: 2.4rem;
  }
  .heroi__acoes { display: flex; flex-wrap: wrap; gap: 0.9rem; }

  /* faixa da rota */
  .rota { padding-block: 1.7rem; }
  .rota__grade { display: grid; gap: 1.3rem; }
  @media (min-width: 900px) {
    .rota__grade { grid-template-columns: auto 1fr; gap: 3.5rem; align-items: start; }
  }
  .rota__legenda { margin: 0; white-space: nowrap; }
  .rota__legenda span { display: block; color: rgba(18, 16, 12, 0.45); }

  .rota__lista { list-style: none; margin: 0; padding: 0; display: grid; gap: 1.1rem 2.2rem; }
  @media (min-width: 640px) { .rota__lista { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .rota__lista { grid-template-columns: repeat(4, 1fr); } }

  .rota__item {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.6rem;
    border-top: 1px dotted rgba(18, 16, 12, 0.35);
  }
  .rota__num { color: rgba(18, 16, 12, 0.5); }
  .rota__nome {
    font-family: var(--display);
    font-size: 1.18rem;
    text-transform: uppercase;
    letter-spacing: 0.07em;
    color: var(--tinta);
    box-shadow: inset 0 -2px 0 var(--fio);
    justify-self: start;
    padding-bottom: 2px;
  }
  .rota__vocacao { font-size: 0.82rem; line-height: 1.45; color: rgba(18, 16, 12, 0.66); }
</style>
