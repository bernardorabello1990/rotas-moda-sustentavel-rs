---
const passos = [
  { titulo: 'Exploração', texto: 'Levantamento documental e análise de estudos, políticas públicas e mapeamentos já existentes.' },
  { titulo: 'Mapeamento', texto: 'Identificação de agentes, vocações e práticas da moda sustentável em cada território.' },
  { titulo: 'Escuta em campo', texto: 'Entrevistas em profundidade e escutas sensíveis, com registro em áudio e fotografia dos processos.' },
  { titulo: 'Análise', texto: 'Consolidação dos dados em um relatório técnico-cultural com recomendações estratégicas.' },
  { titulo: 'Devolução pública', texto: 'Podcast, plataforma de mapeamento e evento de lançamento em Porto Alegre.' },
];
---
<section id="metodologia" class="secao metodologia">
  <div class="container">
    <h2 class="titulo metodologia__titulo">Cinco movimentos de escuta</h2>

    <!-- partitura de método: número real, movimento, procedimento -->
    <ol class="metodo">
      {passos.map((p, i) => (
        <li class="metodo__mov revelar">
          <span class="metodo__num">{String(i + 1).padStart(2, '0')}</span>
          <h3 class="metodo__nome">{p.titulo}</h3>
          <p class="metodo__texto">{p.texto}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .metodologia { background: var(--indigo-fundo); }
  .metodologia__titulo { max-width: 20ch; margin-bottom: 2.8rem; }

  .metodo { list-style: none; margin: 0; padding: 0; border-bottom: 1px solid var(--urdume); }

  .metodo__mov {
    display: grid;
    gap: 0.5rem 1.4rem;
    padding-block: 1.7rem;
    border-top: 1px solid var(--urdume);
  }
  @media (min-width: 720px) {
    .metodo__mov {
      grid-template-columns: 3.6rem minmax(0, 1fr);
      padding-block: 2rem;
    }
    .metodo__num { grid-column: 1; grid-row: 1 / span 2; }
    .metodo__nome { grid-column: 2; grid-row: 1; }
    .metodo__texto { grid-column: 2; grid-row: 2; }
  }
  @media (min-width: 1080px) {
    .metodo__mov {
      grid-template-columns: 4.5rem minmax(0, 15rem) minmax(0, 1fr);
      gap: 2.2rem;
      align-items: start;
    }
    .metodo__num { grid-row: 1; }
    .metodo__texto { grid-column: 3; grid-row: 1; }
  }

  .metodo__num {
    font-family: var(--razao);
    font-size: 1.35rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1.15;
    color: var(--ouro);
    font-variant-numeric: tabular-nums;
  }

  .metodo__nome {
    font-size: clamp(1.55rem, 2.2vw, 1.85rem);
    line-height: 1.14;
    letter-spacing: 0.07em;
    color: var(--linho);
    margin: 0;
  }

  .metodo__texto {
    margin: 0;
    max-width: 46ch;
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--linho);
  }
</style>
