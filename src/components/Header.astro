---
const links = [
  { rotulo: 'O Projeto', href: '#o-projeto' },
  { rotulo: 'Regiões', href: '#regioes' },
  { rotulo: 'Podcast', href: '#podcast' },
  { rotulo: 'Equipe', href: '#equipe' },
  { rotulo: 'Contato', href: '#contato' },
];
---
<header class="topo" data-topo>
  <div class="container topo__linha">
    <a class="topo__marca" href="#conteudo">Rotas da Moda <em>Sustentável RS</em></a>
    <button class="topo__hamb" type="button" aria-label="Abrir menu" aria-expanded="false" aria-controls="menu-principal">
      <span></span><span></span><span></span>
    </button>
    <nav id="menu-principal" class="topo__nav" aria-label="Navegação principal">
      <ul class="topo__menu">
        {links.map((l) => (
          <li><a href={l.href} class:list={['topo__link', { 'topo__link--destaque': l.href === '#contato' }]}>{l.rotulo}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<script is:inline>
  (function () {
    var header = document.querySelector('[data-topo]');
    if (!header) return;
    var btn = header.querySelector('.topo__hamb');
    function fechar() {
      header.removeAttribute('data-aberto');
      btn.setAttribute('aria-expanded', 'false');
      btn.setAttribute('aria-label', 'Abrir menu');
    }
    btn.addEventListener('click', function () {
      var aberto = header.toggleAttribute('data-aberto');
      btn.setAttribute('aria-expanded', String(aberto));
      btn.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');
    });
    header.querySelectorAll('.topo__link').forEach(function (a) {
      a.addEventListener('click', fechar);
    });

    // no topo a navegação flutua sobre a fotografia; assim que a página rola ela
    // fecha em superfície sólida, senão o conteúdo das seções claras vaza por trás
    function marcarRolagem() {
      header.toggleAttribute('data-rolado', window.scrollY > 40);
    }
    marcarRolagem();
    window.addEventListener('scroll', marcarRolagem, { passive: true });
  })();
</script>

<style>
  /* A navegação flutua sobre a fotografia do hero. Nada de barra opaca: uma película
     de oliva deixa a imagem passar por baixo e ainda garante AA no texto. */
  .topo {
    position: fixed;
    inset-inline: 0;
    top: 0;
    z-index: 50;
    padding-block: 0.85rem;
    background: color-mix(in srgb, var(--oliva-fundo) 78%, transparent);
    /* o desfoque impede que texto de seção apareça como fantasma sob a navegação,
       sem precisar fechar a faixa em cor sólida */
    -webkit-backdrop-filter: blur(9px);
    backdrop-filter: blur(9px);
    border-bottom: 1px solid var(--urdume);
    transition: background-color 0.3s ease;
  }
  .topo[data-rolado] { background: var(--oliva-fundo); }
  .topo__linha {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.6rem 1.5rem;
  }

  /* assinatura da marca como estava antes do redesign: caixa mista, peso,
     e o "Sustentável RS" em itálico leve. Só as cores mudam de sistema. */
  .topo__marca {
    font-family: var(--corpo);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--osso);
    text-decoration: none;
    white-space: nowrap;
  }
  .topo__marca em {
    font-style: italic;
    font-weight: 400;
    color: var(--osso);
  }

  .topo__menu {
    display: flex;
    flex-wrap: wrap;
    gap: 0.2rem 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .topo__link {
    font-family: var(--corpo);
    font-size: 0.82rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--osso-2);
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .topo__link:hover { color: var(--osso); }
  /* ênfase por régua de 1px, não por botão: o texto continua em linho (alto
     contraste) e o ouro entra só como fio estrutural */
  .topo__link--destaque {
    color: var(--osso);
    padding-bottom: 3px;
    border-bottom: 1px solid var(--latao);
  }
  .topo__link--destaque:hover { border-bottom-color: var(--latao-claro); }

  /* Botão hambúrguer: escondido no desktop */
  .topo__hamb {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 42px;
    height: 38px;
    padding: 8px;
    background: transparent;
    border: none;
    cursor: pointer;
  }
  .topo__hamb span {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--osso);
    transition: transform 0.25s ease, opacity 0.2s ease;
  }

  /* Mobile */
  @media (max-width: 767px) {
    .topo__hamb { display: flex; }
    /* a assinatura quebra em duas linhas em vez de comprimir a linha inteira */
    .topo__marca { white-space: normal; }
    .topo__marca em { display: block; }

    .topo__nav {
      flex-basis: 100%;
      display: none;
      padding-top: 0.4rem;
      margin-top: 0.7rem;
      border-top: 1px solid var(--urdume);
    }
    /* menu aberto vira superfície fechada: texto nunca compete com a fotografia */
    .topo[data-aberto] { background: var(--oliva-fundo); }
    .topo[data-aberto] .topo__nav { display: block; }

    .topo__menu { flex-direction: column; gap: 0; }
    .topo__menu li + li { border-top: 1px solid var(--urdume); }
    .topo__link {
      display: block;
      padding: 0.9rem 0.2rem;
      font-size: 0.8rem;
    }
    .topo__link--destaque {
      border-bottom: none;
      padding-bottom: 0.9rem;
      color: var(--latao);
    }
    /* hambúrguer vira "x" quando aberto */
    .topo[data-aberto] .topo__hamb span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
    .topo[data-aberto] .topo__hamb span:nth-child(2) { opacity: 0; }
    .topo[data-aberto] .topo__hamb span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }
  }
</style>
