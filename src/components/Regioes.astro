---
import regioes from '../data/regioes.json';
import type { Regiao } from '../data/tipos.ts';

// fios de território: marca fina, nunca área. Mesma ordem e numeração da faixa do Hero.
const fio: Record<string, string> = {
  serra: 'var(--fio-serra)',
  sinos: 'var(--fio-sinos)',
  campanha: 'var(--fio-campanha)',
  metropolitana: 'var(--fio-poa)',
};
const ordem = ['serra', 'sinos', 'campanha', 'metropolitana'];

const lista = ordem
  .map((id) => (regioes as Regiao[]).find((r) => r.id === id))
  .filter((r): r is Regiao => Boolean(r));
---
<section id="regioes" class="secao">
  <div class="container">
    <div class="regioes__cabeca revelar">
      <h2 class="titulo">Quatro territórios, quatro vocações</h2>
      <p class="regioes__intro">
        Cada região do estado teceu, ao longo do tempo, uma relação própria entre moda, cultura e
        sustentabilidade. São essas vocações que a pesquisa percorre.
      </p>
    </div>

    <!-- livro-razão tecido: cada território é uma entrada, separada por filete de urdume -->
    <div class="livro">
      <p class="razao livro__regua" aria-hidden="true">
        <span>Nº</span><span>Matéria-prima</span><span>Território e vocação</span><span>Nota de campo</span>
      </p>
      <ol class="livro__lista">
        {lista.map((r, i) => (
          <li class="livro__item revelar" style={`--fio:${fio[r.id]}`}>
            <span class="razao livro__num">{String(i + 1).padStart(2, '0')}</span>
            {r.imagem && (
              <img
                class="livro__materia"
                src={r.imagem}
                alt={r.imagemAlt ?? ''}
                width="600" height="800"
                loading="lazy" decoding="async"
              />
            )}
            <div class="livro__id">
              <h3 class="livro__nome">{r.nome}</h3>
              <p class="livro__vocacao">{r.vocacao}</p>
            </div>
            <p class="livro__texto">{r.texto}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .regioes__cabeca { margin-bottom: 3.5rem; }
  .regioes__intro { color: var(--osso); max-width: 36rem; margin: 0; }

  .livro__regua,
  .livro__item { column-gap: 2.5rem; }

  /* a régua de índice só aparece quando as colunas realmente existem */
  .livro__regua { display: none; margin: 0 0 0.9rem; max-width: none; }

  .livro__lista {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--urdume);
  }

  .livro__item {
    position: relative;
    display: grid;
    gap: 0.7rem;
    padding-block: 1.6rem 1.9rem;
    border-top: 1px solid var(--urdume);
  }
  /* o fio do território cruza o filete: 2px, marca pequena */
  .livro__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: -1px;
    width: 2.6rem;
    height: 2px;
    background: var(--fio);
  }

  .livro__num { color: var(--osso-2); font-size: 0.75rem; }

  /* estudo de matéria-prima: retângulo 3:4, sem canto e sem sombra, moldado
     por um filete de urdume. É amostra de tecido, não ilustração. */
  .livro__materia {
    width: 10rem;
    /* sem height:auto o atributo height do HTML vira dica de estilo e estica a imagem */
    height: auto;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    border: 1px solid var(--urdume);
  }

  .livro__nome {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    letter-spacing: 0.055em;
    margin: 0 0 0.45rem;
  }
  .livro__vocacao {
    margin: 0;
    font-size: 0.86rem;
    font-weight: 500;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    line-height: 1.45;
    color: var(--osso);
    max-width: 26ch;
  }
  .livro__texto {
    margin: 0;
    font-size: 0.98rem;
    color: var(--osso);
  }

  @media (min-width: 900px) {
    .livro__regua { display: grid; }
    .livro__regua,
    .livro__item {
      grid-template-columns: 3.25rem 10rem minmax(0, 17rem) minmax(0, 27rem);
      align-items: start;
    }
    .livro__item { padding-block: 2.2rem 2.5rem; }
    .livro__num { padding-top: 0.5rem; }
    .livro__materia { width: 100%; }
  }
</style>
