---
import regioes from '../data/regioes.json';
import { site } from '../data/site.ts';

// contagem real, lida dos dados: nunca um número escrito à mão
const territorios = String(regioes.length).padStart(2, '0');
---
<section id="o-projeto" class="secao">
  <div class="container projeto revelar">
    <div class="projeto__tese">
      <h2 class="titulo projeto__titulo">A moda como campo cultural</h2>

      <!-- régua de índice: só dados verificáveis -->
      <dl class="projeto__ficha">
        <div class="projeto__linha">
          <dt class="razao projeto__rotulo">Territórios em escuta</dt>
          <dd class="projeto__valor">{territorios}</dd>
        </div>
        <div class="projeto__linha">
          <dt class="razao projeto__rotulo">Recorte da pesquisa</dt>
          <dd class="projeto__valor">RS</dd>
        </div>
      </dl>
    </div>

    <div class="projeto__texto">
      <p class="projeto__lede">
        A moda raramente é tratada como campo cultural estruturado nas políticas públicas, apesar de sua
        relação profunda com identidade, território, memória, festas e saberes tradicionais. O
        <strong>Rotas da Moda Sustentável RS</strong> nasce para preencher essa lacuna.
      </p>
      <p>
        O projeto realiza uma pesquisa cultural aplicada que mapeia e sistematiza as vocações territoriais
        da moda sustentável no Rio Grande do Sul, ouvindo quem faz: designers, artesãos, coletivos,
        cooperativas, carnavalescos, pequenas indústrias, pesquisadores e agentes culturais.
      </p>
      <p>
        O resultado será um diagnóstico cultural inédito e uma base pública de dados, contribuindo para o
        planejamento e o fortalecimento das políticas culturais e das indústrias criativas do estado.
      </p>
      <p class="projeto__edital">{site.creditoEdital}</p>
    </div>
  </div>

  <!-- prancha editorial: o tear jacquard, que programa o desenho antes de tecer -->
  <figure class="prancha revelar">
    <img
      src="/imagens/textura/tear-jacquard.webp"
      alt="Urdume de fios índigo tensionados em um tear jacquard, atravessados por fios dourados, com um cartão perfurado apoiado nas linhas."
      width="1376" height="768" loading="lazy" decoding="async"
    />
    <figcaption class="razao prancha__legenda">
      No tear jacquard, o cartão perfurado programa o desenho antes de a trama existir
    </figcaption>
  </figure>
</section>

<style>
  .projeto { display: grid; gap: 2.8rem; }
  @media (min-width: 900px) {
    .projeto {
      grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
      gap: 2.6rem;
      align-items: start;
    }
  }

  .projeto__titulo {
    font-size: clamp(2.1rem, 4.6vw, 3.8rem);
    letter-spacing: 0.05em;
    max-width: 13ch;
    margin-bottom: 2.4rem;
  }

  /* ficha: valor à esquerda em monoespaçada, rótulo à direita */
  .projeto__ficha { margin: 0; max-width: 22rem; }
  .projeto__linha {
    display: grid;
    grid-template-columns: 3.4rem minmax(0, 1fr);
    gap: 1rem;
    align-items: baseline;
    padding-block: 0.85rem;
    border-top: 1px dotted var(--urdume);
  }
  .projeto__linha:last-child { border-bottom: 1px dotted var(--urdume); }
  .projeto__valor {
    grid-column: 1;
    grid-row: 1;
    margin: 0;
    font-family: var(--razao);
    font-size: 1.5rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    line-height: 1;
    color: var(--ouro);
    font-variant-numeric: tabular-nums;
  }
  .projeto__rotulo { grid-column: 2; grid-row: 1; margin: 0; color: var(--linho); }

  /* o texto vive numa coluna estreita, separada por uma régua de urdume */
  @media (min-width: 900px) {
    .projeto__texto {
      border-left: 1px solid var(--urdume);
      padding-left: 2.6rem;
    }
  }
  .projeto__texto p { max-width: 52ch; color: var(--linho); }
  .projeto__texto p:last-child { margin-bottom: 0; }
  .projeto__lede { font-size: 1.14rem; line-height: 1.6; }
  .projeto__lede strong { font-weight: 500; color: var(--ouro); }

  /* a prancha sangra de borda a borda: é a única imagem larga da página */
  .prancha { margin: 4.5rem 0 0; }
  @media (min-width: 900px) { .prancha { margin-top: 6rem; } }
  .prancha img {
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  .prancha__legenda {
    max-width: var(--largura);
    margin: 0.9rem auto 0;
    padding-inline: 1.5rem;
    color: var(--linho-2);
  }
  @media (min-width: 900px) { .prancha__legenda { padding-inline: 3rem; } }

  .projeto__edital {
    margin-top: 2.6rem;
    padding-top: 1rem;
    border-top: 1px solid var(--urdume);
    font-family: var(--razao);
    font-size: 0.78rem;
    line-height: 1.6;
    letter-spacing: 0.02em;
    color: var(--linho);
  }
</style>
